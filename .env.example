# Copy to .env.local and fill in values from `npx supabase status` (local) or the Supabase dashboard.
# Only NEXT_PUBLIC_* values are exposed to the browser. Never put secrets here with that prefix.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-from-supabase-status>

# Server-only (never prefix with NEXT_PUBLIC_). Local values come from `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
# E-mail: "mailpit" (local, HTTP API of the Supabase Mailpit container), "smtp" (hosted) or "log" (print only).
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://127.0.0.1:54324
SMTP_URL=
EMAIL_FROM="المجتمع السعودي للمطورين <no-reply@sdc.example>"
# Shared secret for the retry route (GET /api/cron/email-retry, Authorization: Bearer <secret>), min 16 chars.
CRON_SECRET=
SITE_URL=http://localhost:3000

